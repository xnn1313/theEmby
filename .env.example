# 复制为 .env 后填写。注意：.env 已加入 .gitignore，不要提交。

# ---- 上游 Emby（必填）----
NB_UPSTREAM=https://embyf.bbstzb.org
NB_API_KEY=请填写你的Emby API Key

# ---- 监听地址 ----
NB_LISTEN=:8091

# ---- 路径映射（可选）----
# 默认 /CloudNAS/CloudDrive/115open=/（nextemby 形态：该前缀对应 115 根目录）。
# 多条规则用 ; 分隔，如：/CloudNAS/CloudDrive/115open=/;/mnt/tv=/115/剧集
# NB_PATH_MAP=

# ---- /nb/stream 签发密钥（可选）----
# 不设则每次启动随机生成，重启后旧播放链接失效。生产建议固定一个 32 字节以上的随机串。
# NB_HMAC_KEY=

# ---- 管理后台与 Cookie 加密（可选）----
# NB_ADMIN_TOKEN 留空则启动时随机生成并打印到容器日志（docker logs 可见）。
# NB_ADMIN_TOKEN=
# NB_COOKIE_KEY 留空则启动时随机生成（只告警，不打印；重启后已存 Cookie 无法解密）。
# NB_COOKIE_KEY=

# ---- 115 账号（可选；不填则为演示模式：播放劫持优雅降级为原样透传）----
# 从浏览器登录 115 后复制 Cookie（形如 UID=...;CID=...;SEID=...;），只填你自己的小号，
# 不要在任何地方转发。Cookie 失效时容器启动即报错退出。
# NB_115_COOKIE=
# NB_115_ACCOUNT=115小1
# 种子账号（115大）：不填则种子走内存演示，秒传兜底分支不可用。
# NB_115_SEED_COOKIE=
# NB_115_SEED_ACCOUNT=115大

# ---- SQLite 持久化 ----
# 默认 ./nextemby.db；docker-compose 里固定用 /data/nextemby.db（+ ./data volume）。
# 注意镜像以非 root 用户（65532）运行，宿主机先执行：
#   mkdir -p data && sudo chown -R 65532:65532 data
# NB_DB_PATH=
